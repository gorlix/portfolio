#!/bin/sh
# Blocca il commit se nei file in stage compare un segreto. La CI scansiona comunque tutta la history.
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks non installato, scansione segreti SALTATA (la CI la esegue comunque)." >&2
  echo "            Installalo: https://github.com/gitleaks/gitleaks#installing" >&2
  exit 0
fi
exec gitleaks git --pre-commit --staged --redact --no-banner
