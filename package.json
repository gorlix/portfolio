{
  "name": "portfolio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "predev": "pnpm cms:assets",
    "dev": "astro dev",
    "prebuild": "pnpm cms:assets",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "lint": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "cms:config": "node --import ./scripts/register-ts.mjs scripts/cms-config.ts",
    "cms:assets": "node scripts/copy-cms.mjs",
    "check:theme": "node scripts/check-theme.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "prepare": "git config core.hooksPath .githooks",
    "check:machine": "node scripts/validate-machine.ts dist",
    "check:budget": "node scripts/check-budget.ts dist"
  },
  "dependencies": {
    "@catppuccin/palette": "^1.8.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "astro": "^7.4.2",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "2.6.3",
    "@fontsource-variable/material-symbols-outlined": "5.3.9",
    "@fontsource-variable/source-sans-3": "5.3.1",
    "@fontsource/noto-mono": "5.3.0",
    "@playwright/test": "^1.64.1",
    "@sveltia/cms": "0.253.2",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "ajv": "8.20.0",
    "fast-xml-parser": "^5.11.2",
    "fast-xml-validator": "^1.4.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}
