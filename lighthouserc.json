{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": [
        "/index.html",
        "/en/index.html",
        "/recruiter/index.html",
        "/en/recruiter/index.html",
        "/agent/index.html",
        "/en/agent/index.html",
        "/human/index.html",
        "/en/human/index.html",
        "/human/lavori/trimind/index.html",
        "/en/human/lavori/trimind/index.html",
        "/human/lavori/open-source/index.html",
        "/en/human/lavori/open-source/index.html"
      ],
      "numberOfRuns": 1
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "^https?://[^/]+/(en/)?index\\.html$",
          "assertions": {
            "categories:performance": [
              "warn",
              {
                "minScore": 0.95
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:best-practices": [
              "warn",
              {
                "minScore": 0.95
              }
            ],
            "categories:seo": [
              "warn",
              {
                "minScore": 0.95
              }
            ],
            "resource-summary:total:size": [
              "warn",
              {
                "maxNumericValue": 100000
              }
            ],
            "resource-summary:script:count": [
              "error",
              {
                "maxNumericValue": 1
              }
            ]
          }
        },
        {
          "matchingUrlPattern": "^https?://[^/]+/(en/)?(recruiter|agent)/index\\.html$",
          "assertions": {
            "categories:performance": [
              "warn",
              {
                "minScore": 0.95
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:best-practices": [
              "warn",
              {
                "minScore": 0.95
              }
            ],
            "categories:seo": [
              "warn",
              {
                "minScore": 0.95
              }
            ],
            "resource-summary:total:size": [
              "warn",
              {
                "maxNumericValue": 100000
              }
            ],
            "resource-summary:script:count": [
              "error",
              {
                "maxNumericValue": 0
              }
            ]
          }
        },
        {
          "matchingUrlPattern": "^https?://[^/]+/(en/)?human/(lavori/[a-z0-9-]+/)?index\\.html$",
          "assertions": {
            "categories:performance": [
              "warn",
              {
                "minScore": 0.65
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:best-practices": [
              "warn",
              {
                "minScore": 0.95
              }
            ],
            "categories:seo": [
              "warn",
              {
                "minScore": 0.95
              }
            ],
            "resource-summary:script:size": [
              "error",
              {
                "maxNumericValue": 163840
              }
            ],
            "resource-summary:script:count": [
              "error",
              {
                "maxNumericValue": 6
              }
            ]
          }
        }
      ]
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
