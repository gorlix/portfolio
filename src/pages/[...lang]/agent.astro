---
import Base from '../../layouts/Base.astro';
import { getSingleton } from '../../lib/data';
import { localeStaticPaths, localizedPath } from '../../lib/i18n';
import { machineFileNames, renderMachineFiles } from '../../lib/machine/files';
import { loadJsonLd } from '../../lib/machine/page-jsonld';
import type { Locale } from '../../lib/schemas/common';

export const getStaticPaths = localeStaticPaths;

const { locale } = Astro.props as { locale: Locale };
const [page, profile, files] = await Promise.all([
  getSingleton('agent', locale),
  getSingleton('profile', locale),
  renderMachineFiles(),
]);
const here = (path: string) => localizedPath(path, locale);
const pageTitle = `${profile.name} · ${page.titleSuffix}`;
const jsonLd = await loadJsonLd({
  locale,
  path: '/agent',
  name: pageTitle,
  type: 'WebPage',
});
---

<Base
  locale={locale}
  path="/agent"
  title={pageTitle}
  jsonLd={jsonLd}
  description={page.metaDescription}
  stickyHeader
>
  <Fragment slot="header">
    <a class="back" href={here('/')}>{page.backToChoice}</a>
    <nav class="menu" aria-label={page.menuLabel}>
      <ul>
        <li><a href={here('/human')}>{page.links.human}</a></li>
        <li><a href={here('/recruiter')}>{page.links.recruiter}</a></li>
      </ul>
    </nav>
  </Fragment>

  <div class="terminal">
    <header class="bar">
      <h1>{profile.name} · {page.titleSuffix}</h1>
    </header>
    <div class="screen">
      <p class="note">{page.languageNote}</p>

      <table>
        <caption>{page.table.caption}</caption>
        <thead>
          <tr>
            <th scope="col">{page.table.file}</th>
            <th scope="col">{page.table.description}</th>
            <th scope="col">{page.table.link}</th>
          </tr>
        </thead>
        <tbody>
          {
            page.files.map((f) => (
              <tr>
                <th scope="row"><code>{f.name}</code></th>
                <td>{f.description}</td>
                <td><a href={`/${f.name}`} download>{page.download}<span class="sr-only"> {f.name}</span></a></td>
              </tr>
            ))
          }
        </tbody>
      </table>

      {
        machineFileNames.map((name) => (
          <section aria-labelledby={`f-${name}`}>
            <h2 id={`f-${name}`}><span class="prompt">{page.command} </span>{name}</h2>
            <pre tabindex="0" data-file={name}><code>{files[name]}</code></pre>
            <p><a href={`/${name}`} download>{page.download} <code>{name}</code></a></p>
          </section>
        ))
      }
    </div>
  </div>
</Base>

<style>
  .screen a {
    color: var(--link);
    text-decoration: underline;
  }
  .menu ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }
  .terminal {
    max-width: 56rem;
    margin: 2rem auto;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    background: var(--bg-alt);
    font-family: var(--font-mono);
    overflow: hidden;
  }
  .bar {
    box-sizing: border-box;
    min-height: 2.5rem;
    padding: 0.25rem 1rem;
    display: flex;
    align-items: center;
    background: var(--surface);
    border-bottom: 1px solid var(--border);
  }
  h1 {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-muted);
  }
  .screen {
    padding: 1rem;
    line-height: 1.6;
  }
  .note {
    margin: 0 0 1rem;
    color: var(--text-muted);
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
  }
  caption {
    padding-bottom: 0.5rem;
    text-align: left;
    color: var(--text-muted);
  }
  th,
  td {
    padding: 0.375rem 0.5rem;
    border-bottom: 1px solid var(--border);
    text-align: left;
    vertical-align: top;
  }
  thead th {
    font-weight: 700;
  }
  tbody th {
    font-weight: 400;
  }
  section {
    margin-top: 2rem;
  }
  h2 {
    margin: 0 0 0.5rem;
    font-size: 1rem;
  }
  .prompt {
    color: var(--text-muted);
  }
  pre {
    margin: 0;
    padding: 0.75rem 1rem;
    border: 1px solid var(--border);
    border-radius: 0.25rem;
    background: var(--bg-deep);
    font-size: 0.8125rem;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .screen p {
    margin: 0.5rem 0 0;
  }
  .screen .note {
    margin: 0 0 1rem;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
