---
import Base from '../../layouts/Base.astro';
import { getSingleton } from '../../lib/data';
import { localeStaticPaths, localizedPath } from '../../lib/i18n';
import {
  describeMachineFiles,
  machineFileNames,
  renderMachineFiles,
} from '../../lib/machine/files';
import { loadJsonLd } from '../../lib/machine/page-jsonld';
import type { Locale } from '../../lib/schemas/common';

export const getStaticPaths = localeStaticPaths;

const { locale } = Astro.props as { locale: Locale };
const [page, profile, files] = await Promise.all([
  getSingleton('agent', locale),
  getSingleton('profile', locale),
  renderMachineFiles(),
]);
const info = await describeMachineFiles(files);
const here = (path: string) => localizedPath(path, locale);
const pageTitle = `${profile.name} · ${page.titleSuffix}`;
const size = (bytes: number) => `${(bytes / 1024).toFixed(1)} KB`;
const jsonLd = await loadJsonLd({
  locale,
  path: '/agent',
  name: pageTitle,
  type: 'WebPage',
});
const mascot = ['    ,', '  .-"-.', ' ( o o )', " /'-v-'\\", '/(     )\\', ' ^^   ^^'].join('\n');
---

<Base
  locale={locale}
  path="/agent"
  title={pageTitle}
  jsonLd={jsonLd}
  description={page.metaDescription}
  theme="mocha"
  stickyHeader
>
  <Fragment slot="header">
    <a class="back" href={here('/')}>{page.backToChoice}</a>
    <nav class="menu" aria-label={page.menuLabel}>
      <ul>
        <li><a href={here('/human')}>{page.links.human}</a></li>
        <li><a href={here('/recruiter')}>{page.links.recruiter}</a></li>
      </ul>
    </nav>
  </Fragment>

  <div class="console">
    <header class="bar">
      <p class="unit"><span class="label">{page.unitLabel}</span> {profile.name} <span class="sep">·</span> {profile.role}</p>
    </header>

    <div class="screen">
      <section class="hero">
        <pre class="mascot" aria-hidden="true">{mascot}</pre>
        <div class="intro">
          <h1>{profile.name} · {page.titleSuffix}</h1>
          <p class="greeting">{page.greeting}</p>
          <p class="note">{page.languageNote}</p>
        </div>
      </section>

      <section aria-labelledby="boot">
        <h2 id="boot">{page.boot.title}</h2>
        <ul class="boot">
          {
            info.map((f) => (
              <li>
                <span class="ok">[ {page.boot.ok} ]</span>
                <code class="fname">{f.name}</code>
                <span class="meta">{size(f.bytes)}</span>
                <span class="meta">sha256:{f.sha256}</span>
              </li>
            ))
          }
        </ul>
        <p class="caption">{page.boot.note}</p>
      </section>

      <section aria-labelledby="entries">
        <h2 id="entries">{page.entries.title}</h2>
        <ul class="entries">
          {
            page.entries.items.map((e) => (
              <li>
                <p class="headline">{e.headline} <code class="fname">{e.name}</code></p>
                <p>{e.description}</p>
                <p class="use">{page.entries.useFor} {e.use}</p>
                <p><a href={`/${e.name}`} download>{page.download}<span class="sr-only"> {e.name}</span></a></p>
              </li>
            ))
          }
        </ul>
      </section>

      <section aria-labelledby="raw">
        <h2 id="raw">{page.raw.title}</h2>
        <p class="caption">{page.raw.intro}</p>
        {
          machineFileNames.map((name) => (
            <details>
              <summary><span class="prompt">{page.command} </span>{name}</summary>
              <pre tabindex="0" data-file={name}><code>{files[name]}</code></pre>
            </details>
          ))
        }
      </section>
    </div>
  </div>
</Base>

<style>
  .screen a {
    color: var(--link);
    text-decoration: underline;
  }
  .menu ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }
  .console {
    max-width: 56rem;
    margin: 2rem auto;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    background: var(--bg-alt);
    font-family: var(--font-mono);
    overflow: hidden;
  }
  .bar {
    box-sizing: border-box;
    min-height: 2.5rem;
    padding: 0.25rem 1rem;
    display: flex;
    align-items: center;
    background: var(--surface);
    border-bottom: 1px solid var(--border);
  }
  .unit {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--text-muted);
    overflow-wrap: anywhere;
  }
  .label {
    color: var(--sec-homelab-ink);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .sep {
    color: var(--border);
  }
  .screen {
    padding: 1.25rem 1rem 1.5rem;
    line-height: 1.6;
  }
  .screen section + section {
    margin-top: 2rem;
  }
  .hero {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem 1.5rem;
    align-items: start;
  }
  .mascot {
    margin: 0;
    color: var(--sec-homelab-ink);
    font-size: 0.9375rem;
    line-height: 1.2;
  }
  h1 {
    margin: 0 0 0.5rem;
    font-size: 1.125rem;
  }
  h2 {
    margin: 0 0 0.75rem;
    padding-bottom: 0.375rem;
    border-bottom: 1px solid var(--border);
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--sec-homelab-ink);
  }
  .greeting {
    margin: 0 0 0.5rem;
  }
  .note,
  .caption {
    margin: 0.5rem 0 0;
    color: var(--text-muted);
    font-size: 0.8125rem;
  }
  ul.boot,
  ul.entries {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .boot li {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr) 5rem 9.5rem;
    gap: 0 0.75rem;
    padding: 0.125rem 0;
    font-size: 0.875rem;
  }
  .ok {
    color: var(--sec-homelab-ink);
  }
  .meta {
    color: var(--text-muted);
    text-align: right;
  }
  .entries li {
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--border);
  }
  .entries li:last-child {
    border-bottom: 0;
  }
  .entries p {
    margin: 0.125rem 0 0;
    font-size: 0.875rem;
  }
  .headline {
    font-size: 1rem !important;
    font-weight: 700;
  }
  .fname {
    font-weight: 400;
    color: var(--text-muted);
    font-size: 0.8125rem;
  }
  .use {
    color: var(--text-muted);
  }
  details {
    margin-top: 0.5rem;
    border: 1px solid var(--border);
    border-radius: 0.25rem;
    background: var(--bg-deep);
  }
  summary {
    padding: 0.5rem 0.75rem;
    cursor: pointer;
    font-size: 0.875rem;
  }
  .prompt {
    color: var(--text-muted);
  }
  pre {
    margin: 0;
  }
  details pre {
    padding: 0.75rem 1rem;
    border-top: 1px solid var(--border);
    font-size: 0.8125rem;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* Avvio: solo opacità, nessuno spostamento. Il contenuto è sempre nel flusso. */
  @keyframes appear {
    from {
      opacity: 0;
    }
  }
  .boot li {
    animation: appear 0.3s ease-out backwards;
  }
  .boot li:nth-child(1) { animation-delay: 0.1s; }
  .boot li:nth-child(2) { animation-delay: 0.25s; }
  .boot li:nth-child(3) { animation-delay: 0.4s; }
  .boot li:nth-child(4) { animation-delay: 0.55s; }
  .boot li:nth-child(5) { animation-delay: 0.7s; }
  @media (prefers-reduced-motion: reduce) {
    .boot li {
      animation: none;
    }
  }

  @media (max-width: 40rem) {
    .hero {
      grid-template-columns: 1fr;
    }
    .boot li {
      grid-template-columns: 3rem minmax(0, 1fr);
    }
    .boot .meta {
      grid-column: 2;
      text-align: left;
    }
  }
</style>
