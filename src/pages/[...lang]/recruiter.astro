---
import Portrait from '../../components/Portrait.astro';
import Base from '../../layouts/Base.astro';
import { getEntries, getSingleton } from '../../lib/data';
import { formatDate } from '../../lib/format';
import { localeStaticPaths, localizedPath } from '../../lib/i18n';
import { loadJsonLd } from '../../lib/machine/page-jsonld';
import type { Locale } from '../../lib/schemas/common';

export const getStaticPaths = localeStaticPaths;

const { locale } = Astro.props as { locale: Locale };
const [page, profile, skills, experiences, certifications, projects, education] = await Promise.all(
  [
    getSingleton('recruiter', locale),
    getSingleton('profile', locale),
    getEntries('skills', locale),
    getEntries('experiences', locale),
    getEntries('certifications', locale),
    getEntries('projects', locale),
    getEntries('education', locale),
  ],
);

const L = page.labels;
const sectionTitle = (id: string) => page.sections.find((s) => s.id === id)?.title ?? id;
const here = (path: string) => localizedPath(path, locale);

/** Competenze tecniche raggruppate, nell'ordine in cui compaiono i gruppi. */
const skillGroups = [
  ...Map.groupBy(
    skills.filter((s) => s.data.kind === 'technical'),
    (s) => s.data.group,
  ),
];

/** Esperienze dalla piu recente; le date ancora segnaposto restano in fondo. */
const sortedExperiences = [...experiences].sort((a, b) => {
  const start = (e: typeof a) => e.data.start ?? '';
  return start(b).localeCompare(start(a));
});

const isTechnical = (c: (typeof certifications)[number]) => c.data.kind !== 'supplementary';
const technicalCerts = certifications.filter(isTechnical);
const supplementaryCerts = certifications.filter((c) => !isTechnical(c));
const featuredProjects = projects
  .filter((p) => p.data.featured)
  .sort((a, b) => (a.data.rank ?? 99) - (b.data.rank ?? 99) || a.slug.localeCompare(b.slug));

const period = (start: string | undefined, end: string | null | undefined, paused = false) => {
  if (start === undefined || end === undefined) return null;
  const to = end === null ? (paused ? L.paused : L.ongoing) : formatDate(end, locale);
  return `${formatDate(start, locale)} – ${to}`;
};

const certMeta = (c: (typeof certifications)[number]['data']) =>
  [
    c.status === 'in-progress' ? L.ongoing : null,
    c.issuer === undefined ? null : `${L.issuer}: ${c.issuer}`,
    c.status === 'in-progress' || c.date === undefined ? null : formatDate(c.date, locale),
  ]
    .filter(Boolean)
    .join(' · ');

const profiles = [
  { name: 'GitHub', url: profile.links.github },
  { name: 'LinkedIn', url: profile.links.linkedin },
  { name: 'dev.to', url: profile.links.devto },
];
const pageTitle = `${profile.name} · ${page.titleSuffix}`;
const jsonLd = await loadJsonLd({
  locale,
  path: '/recruiter',
  name: pageTitle,
  type: 'ProfilePage',
});
---

<Base
  locale={locale}
  path="/recruiter"
  title={pageTitle}
  jsonLd={jsonLd}
  description={page.metaDescription}
  stickyHeader
>
  <Fragment slot="header">
    <a class="back" href={here('/')}>{page.backToChoice}</a>
    <nav class="menu" aria-label={page.menuLabel}>
      <ul>
        {page.sections.map((s) => <li><a href={`#${s.id}`}>{s.title}</a></li>)}
        <li><a href={here('/human')}>{page.links.human}</a></li>
        <li><a href={here('/agent')}>{page.links.agent}</a></li>
        <li><a href={profile.cv} download>{L.cv}</a></li>
      </ul>
    </nav>
  </Fragment>

  <article class="page">
    <section id="profilo" aria-labelledby="h-profilo" class="opening">
      <Portrait photo={profile.photo} />
      <div class="intro">
        <h1 id="h-profilo">{profile.name}</h1>
        <p class="role">{profile.role}</p>
        <p class="tagline">{profile.tagline}</p>
        <dl class="facts">
          <div>
            <dt>{L.location}</dt>
            <dd>{profile.location}</dd>
          </div>
          <div>
            <dt>{L.availability}</dt>
            <dd>{profile.availability}</dd>
          </div>
        </dl>
        <p class="cta">
          <a class="button" href={profile.cv} download>{L.cv}</a>
        </p>
      </div>
    </section>

    <section id="competenze" aria-labelledby="h-competenze">
      <h2 id="h-competenze">{sectionTitle('competenze')}</h2>
      <div class="skill-groups">
        {
          skillGroups.map(([group, items]) => (
            <div class="skill-group">
              <h3>{group}</h3>
              <ul class="tags">
                {items.map((s) => <li>{s.data.name}</li>)}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <section id="esperienze" aria-labelledby="h-esperienze">
      <h2 id="h-esperienze">{sectionTitle('esperienze')}</h2>
      {
        sortedExperiences.map(({ data: e }) => {
          const when = period(e.start, e.end);
          return (
            <article class="item">
              <h3>{[e.role, e.company].filter(Boolean).join(' · ')}</h3>
              {
                (e.summary || when) && (
                  <p class="meta">
                    {e.summary}
                    {e.summary && when && <br />}
                    {when}
                  </p>
                )
              }
              <h4>{L.results}</h4>
              <ul>{e.results.map((r) => <li>{r}</li>)}</ul>
              {
                e.stack.length > 0 && (
                  <>
                    <h4>{L.stack}</h4>
                    <ul class="tags">{e.stack.map((t) => <li>{t}</li>)}</ul>
                  </>
                )
              }
            </article>
          );
        })
      }
    </section>

    <section id="certificazioni" aria-labelledby="h-certificazioni">
      <h2 id="h-certificazioni">{sectionTitle('certificazioni')}</h2>
      <h3>{L.technicalCertifications}</h3>
      <ul class="plain">
        {
          technicalCerts.map(({ data: c }) => (
            <li>
              <strong>{c.name}</strong>
              {certMeta(c) && <span class="meta">{certMeta(c)}</span>}
              {c.verifyUrl !== undefined && <a href={c.verifyUrl}>{L.verify}</a>}
              {c.credentialId !== undefined && <span class="meta">{L.credentialId}: {c.credentialId}</span>}
            </li>
          ))
        }
      </ul>
      {
        supplementaryCerts.length > 0 && (
          <>
            <h3 class="small">{L.supplementaryCertifications}</h3>
            <ul class="plain small">
              {supplementaryCerts.map(({ data: c }) => (
                <li>
                  {c.name}
                  {c.issuer !== undefined && <span class="meta"> · {c.issuer}</span>}
                  {c.credentialId !== undefined && <span class="meta"> · {L.credentialId}: {c.credentialId}</span>}
                </li>
              ))}
            </ul>
          </>
        )
      }
    </section>

    <section id="progetti" aria-labelledby="h-progetti">
      <h2 id="h-progetti">{sectionTitle('progetti')}</h2>
      <p class="meta">{page.projects.intro}</p>
      {
        featuredProjects.map(({ data: p }) => (
          <article class="item">
            <h3>{p.name}</h3>
            <p>{p.description}</p>
            {
              (p.language !== undefined || p.repo) && (
                <p class="meta">
                  {p.language !== undefined && `${L.language}: ${p.language}`}
                  {p.language !== undefined && p.repo && ' · '}
                  {p.repo && <a href={p.repo}>{L.repository}</a>}
                </p>
              )
            }
            {
              p.method !== undefined && (
                <p class="meta">
                  {page.projects.methodLabel}: {page.projects.methods[p.method]}
                </p>
              )
            }
          </article>
        ))
      }
    </section>

    <section id="formazione" aria-labelledby="h-formazione">
      <h2 id="h-formazione">{sectionTitle('formazione')}</h2>
      {
        education.map(({ data: ed }) => {
          const when = period(ed.start, ed.end, ed.paused);
          return (
            <article class="item">
              <h3>{ed.degree}</h3>
              <p class="meta">{[ed.institution, when].filter(Boolean).join(' · ')}</p>
            </article>
          );
        })
      }
    </section>

    <section id="contatti" aria-labelledby="h-contatti">
      <h2 id="h-contatti">{sectionTitle('contatti')}</h2>
      <dl class="facts">
        <div>
          <dt>{L.email}</dt>
          <dd><a href={`mailto:${profile.email}`}>{profile.email}</a></dd>
        </div>
        <div>
          <dt>{L.languages}</dt>
          <dd>{profile.languages.map((l) => `${l.name}: ${l.level}`).join(' · ')}</dd>
        </div>
        <div>
          <dt>{L.profiles}</dt>
          <dd>
            <ul class="plain inline">
              {profiles.map((p) => <li><a href={p.url}>{p.name}</a></li>)}
            </ul>
          </dd>
        </div>
      </dl>
    </section>
  </article>

  <footer slot="footer" class="foot">
    <ul>
      <li><a href={here('/human')}>{page.links.human}</a></li>
      <li><a href={here('/agent')}>{page.links.agent}</a></li>
      <li><a href={here('/')}>{page.backToChoice}</a></li>
    </ul>
  </footer>
</Base>

<style>
  .foot a,
  .page a {
    color: var(--link);
    text-decoration: underline;
  }
  .menu ul,
  .foot ul,
  .plain,
  .tags {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* Bersagli tattili di almeno 24px (WCAG 2.2, 2.5.8). */
  .menu a,
  .foot a {
    display: inline-flex;
    align-items: center;
    min-height: 1.5rem;
    min-width: 1.5rem;
  }
  .menu ul,
  .foot ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }
  .page {
    max-width: 48rem;
    margin: 0 auto;
    padding: 1rem 1rem 3rem;
    line-height: 1.6;
  }
  section[id] {
    margin-top: 3rem;
    scroll-margin-top: 1rem;
  }
  @media (min-width: 48rem) {
    section[id] {
      scroll-margin-top: 4rem;
    }
  }
  .opening {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    align-items: flex-start;
  }
  .intro {
    flex: 1 1 20rem;
  }
  .tagline {
    margin: 0.5rem 0 0;
  }
  .cta {
    margin: 1rem 0 0;
  }
  .page .button {
    display: inline-block;
    padding: 0.375rem 1rem;
    border: 1px solid var(--border);
    border-radius: 0.25rem;
    background: var(--surface);
    color: var(--text);
    font-family: var(--font-mono);
    text-decoration: none;
  }
  .page .button:hover {
    background: var(--surface-hi);
  }
  h1 {
    margin: 0 0 0.25rem;
    font-size: 2rem;
  }
  h2 {
    margin: 0 0 1rem;
    padding-bottom: 0.25rem;
    border-bottom: 1px solid var(--border);
    font-size: 1.25rem;
  }
  h2::before {
    content: "~/" / "";
    color: var(--text-muted);
  }
  h3 {
    margin: 1rem 0 0.25rem;
    font-size: 1rem;
  }
  h4 {
    margin: 0.75rem 0 0.25rem;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--text-muted);
  }
  .role {
    margin: 0;
    font-size: 1.125rem;
  }
  .facts {
    display: grid;
    gap: 0.5rem;
    margin: 1rem 0 0;
  }
  .facts dt {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--text-muted);
  }
  .facts dd {
    margin: 0;
  }
  .meta {
    margin: 0;
    color: var(--text-muted);
  }
  .item {
    margin-top: 1.5rem;
  }
  .item ul {
    margin: 0;
    padding-left: 1.25rem;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .item .tags {
    padding-left: 0;
  }
  .tags li {
    padding: 0.125rem 0.625rem;
    border: 1px solid var(--border);
    border-radius: 0.25rem;
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }
  .plain li {
    margin-top: 0.75rem;
  }
  .plain .meta {
    display: block;
  }
  .plain.inline {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
  }
  .plain.inline li {
    margin-top: 0;
  }
  .small {
    font-size: 0.875rem;
  }
  .foot {
    max-width: 48rem;
    margin: 0 auto;
    padding: 1rem 1rem 2rem;
    border-top: 1px solid var(--border);
  }
  /* Stampa / PDF: base Latte (theme.css), niente navigazione, URL dei link, pagine A4 compatte. */
  @page {
    size: A4;
    margin: 11mm;
  }
  @media print {
    :global(.skip),
    :global(header.site-header.fixed),
    .foot,
    .cta {
      display: none;
    }
    :global(body) {
      font-size: 8.5pt;
    }
    .page {
      max-width: none;
      padding: 0;
      line-height: 1.25;
    }
    section[id] {
      margin-top: 0.45rem;
    }
    h1 {
      margin-top: 0;
      font-size: 1.6rem;
    }
    h2 {
      break-after: avoid;
      margin-bottom: 0.35rem;
    }
    h3 {
      margin: 0.4rem 0 0.1rem;
    }
    h4 {
      margin: 0.3rem 0 0.1rem;
    }
    h3,
    h4 {
      break-after: avoid;
    }
    .skill-group,
    #progetti .item,
    #formazione .item {
      break-inside: avoid;
    }
    .item {
      margin-top: 0.4rem;
    }
    .plain li {
      margin-top: 0.3rem;
    }
    /* Competenze: una riga per gruppo; progetti: metadati su una riga. Serve a restare entro 2 pagine A4. */
    .skill-group {
      display: flex;
      gap: 0.5rem;
      align-items: baseline;
    }
    .skill-group h3 {
      flex: 0 0 6.5rem;
      margin: 0.15rem 0;
      font-size: 0.85rem;
    }
    /* Le etichette "Risultati" e "Stack" si deducono dal contenuto: in stampa si omettono. */
    .item > h4 {
      display: none;
    }
    #contatti .facts {
      grid-template-columns: repeat(3, auto);
      justify-content: space-between;
      margin-top: 0;
    }
    #certificazioni .plain.small {
      display: flex;
      flex-wrap: wrap;
      gap: 0 1.25rem;
    }
    #formazione .item {
      margin-top: 0.2rem;
    }
    #progetti .item p {
      margin: 0;
    }
    #progetti .item .meta {
      display: inline;
    }
    #progetti .item .meta + .meta::before {
      content: " · ";
    }
    .tags {
      gap: 0.25rem;
    }
    .tags li {
      padding: 0 0.35rem;
      font-size: 0.8rem;
    }
    .page a {
      color: inherit;
      text-decoration: none;
    }
    .page a[href^="http"]::after,
    .page a[href^="mailto:"]::after {
      content: " (" attr(href) ")";
      font-size: 0.8em;
      color: var(--text-muted);
      overflow-wrap: anywhere;
    }
    /* L'indirizzo e gia il testo del link: niente "mailto:" ripetuto. */
    .page a[href^="mailto:"]::after {
      content: none;
    }
  }
</style>
