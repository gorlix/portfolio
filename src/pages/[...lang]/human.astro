  }
  /* Il nome del nodo non si spezza sul trattino ("node-1"). */
  .card th[scope="row"] {
    white-space: nowrap;
  }
  /* Solo a 320 px (zoom 400%) le parole lunghe vanno a capo dove serve. */
  @media (max-width: 22rem) {
    .card :is(th, td) {
      overflow-wrap: anywhere;
