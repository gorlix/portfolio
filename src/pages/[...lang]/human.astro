  }
  /* Il foglio appartiene alla prima schermata: durante le schede non copre il testo. */
  section[data-phase="cards"] .hero .lab-panel {
    display: none;
  }
  /* Schede in vetro smerigliato: bordo nell'accento della sezione, fallback opaco senza blur. */
  .cards {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
    padding-block: 2rem 4rem;
