    padding: 0.5rem 1rem;
  }
  .card h4 {
    color: var(--text);
  }
  /* Senza JavaScript non c'e scena: niente sfondo fisso, le schede restano sul fondo semplice. */
  @media (scripting: none) {
    .stage {
      display: none;
    }
    /* Senza JS la scrivania resta come poster fermo; le altre sezioni restano sul fondo semplice. */
    section[data-section="home"] .stage {
      display: block;
    }
  }
  /*
   * Poster della scrivania: sempre nel markup ma nascosto (e, essendo lazy, mai scaricato) finche il 3D
   * funziona. Compare solo se la scena ripiega sul testo (niente WebGL, risparmio dati) o va in errore,
   * e senza JavaScript.
   */
  .poster {
    display: none;
  }
  .poster img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 60% 50%;
  }
  .stage:has(.scene:is([data-scene-state="text"], [data-scene-state="error"])) .poster {
    display: block;
  }
  @media (scripting: none) {
    section[data-section="home"] .poster {
      display: block;
    }
  }
  /* Avviso sotto il vetro, solo quando al posto del 3D c'e il poster; un solo motivo alla volta. */
  .poster-note {
    display: none;
    margin: 0.75rem 0 0;
    padding-top: 0.5rem;
    border-top: 1px solid var(--border);
    color: var(--text-muted);
    font-size: 0.875rem;
  }
  .poster-note > span {
    display: none;
  }
  /* Domotica: l'avviso sta sotto l'intro, senza vetro intorno; ha un fondo suo per restare leggibile sul poster. */
  .hero.lab > .poster-note {
    max-width: 32rem;
    margin: 0 0 1rem 0.5rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
  }
  section[data-story]:has(.scene[data-scene-state="text"], .scene[data-scene-state="error"]) .poster-note {
