  /*
   * Sezione immersiva (spec §7.3, PORT-76). Sfondo fisso ("stage") con la scena, che resta sotto
   * tutta la sezione grazie a sticky + margine negativo: lo scroll e sempre quello nativo.
   * Il bootstrap mette sulla sezione `data-phase` (hero | cards) e `--stage-opacity`.
   */
  section[data-story] {
    --pad-l: 1rem;
    /* Altezza dell'intestazione fissa (solo da 48rem): il titolo si ferma subito sotto. */
    --head: 0rem;
    position: relative;
    /* Contesto proprio sotto l'intestazione fissa: le schede lunghe le scorrono sotto. */
    z-index: 0;
    padding-block: var(--head) 0;
    background: var(--bg);
  }
  @media (min-width: 48rem) {
    section[data-story] {
      --pad-l: 4rem;
      --head: 2.375rem;
    }
  }
  section[data-story] > .stage {
    max-width: none;
    position: sticky;
    top: 0;
    z-index: 0;
    height: 100svh;
    margin: calc(-1 * var(--head)) -1rem calc(var(--head) - 100svh) calc(-1 * var(--pad-l));
    opacity: var(--stage-opacity, 1);
    background: radial-gradient(ellipse at 60% 45%, color-mix(in srgb, var(--accent) 10%, var(--bg)), var(--bg) 70%);
    pointer-events: none;
  }
  .stage :global(.scene) {
    margin: 0;
  }
  /* Il 3D si usa solo nella prima schermata; durante le schede rotella e dita vanno alla pagina. */
  section[data-phase="hero"] .stage :global(canvas) {
    pointer-events: auto;
  }
  /* Titolo fisso in alto a sinistra finche si e nella sezione; rimpicciolito durante le schede. */
  section[data-story] > :is(h1, h2) {
    position: sticky;
    top: 0;
    z-index: 2;
    display: block;
    width: fit-content;
    margin: 0;
    padding: 1.25rem 2.5rem 0.5rem 0.5rem;
    font-size: clamp(1.75rem, 6vw, 3.25rem);
    transform-origin: left top;
    transition: transform 0.25s ease, background-color 0.25s ease;
    pointer-events: none;
  }
  section[data-story] > :is(h1, h2) {
    top: var(--head);
  }
  /* Durante le schede il titolo ha un fondo pieno: le schede gli scorrono sotto senza mescolarsi. */
  section[data-phase="cards"] > :is(h1, h2) {
    transform: scale(0.6);
    border-radius: 0 0 0.5rem 0;
    background: color-mix(in srgb, var(--bg) 92%, transparent);
  }
  /* Prima schermata: intro in alto a sinistra, comandi a destra; il vuoto lascia passare i gesti al 3D. */
  section[data-story] > .hero {
    position: relative;
    z-index: 1;
    grid-template-columns: minmax(0, 1fr);
    max-width: none;
    margin: 0;
    pointer-events: none;
  }
  .hero > * {
    pointer-events: auto;
  }
  .hero .intro {
    max-width: 32rem;
    margin: 0 0 1rem 0.5rem;
  }
  @media (scripting: enabled) {
    section[data-story] > .hero {
      box-sizing: border-box;
      min-height: calc(100svh - 6rem);
      align-content: space-between;
    }
  }
  @media (min-width: 72rem) {
    section[data-story] > .hero {
      grid-template-columns: minmax(0, 1fr) 22rem;
      align-content: start;
      align-items: start;
    }
    .hero .lab-ui {
      grid-column: 2;
      grid-row: 1 / span 2;
      padding: 1rem;
      border: 1px solid color-mix(in srgb, var(--accent) 45%, var(--border));
      border-radius: 0.75rem;
      background: color-mix(in srgb, var(--bg) 84%, transparent);
      backdrop-filter: blur(12px);
    }
  }
  /* Telefono: comandi in una barra in basso, pannello del nodo come foglio che sale dal basso. */
  @media (max-width: 71.99rem) {
    .hero .lab-ui {
      align-self: end;
      padding: 0.75rem;
      border: 1px solid color-mix(in srgb, var(--accent) 45%, var(--border));
      border-radius: 0.75rem;
      background: color-mix(in srgb, var(--bg) 86%, transparent);
      backdrop-filter: blur(12px);
    }
    .hero .lab-ui > .meta {
