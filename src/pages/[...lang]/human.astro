    }
  }
  .card {
    box-sizing: border-box;
    max-width: 34rem;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--accent);
    border-radius: 0.75rem;
    background: color-mix(in srgb, var(--bg) 86%, transparent);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
