---
import { getImage } from 'astro:assets';
import domoticaPosterDesktopSrc from '../../assets/human/domotica-poster-desktop.png';
import domoticaPosterMobileSrc from '../../assets/human/domotica-poster-mobile.png';
import lavoriPosterDesktopSrc from '../../assets/human/lavori-poster-desktop.png';
import lavoriPosterMobileSrc from '../../assets/human/lavori-poster-mobile.png';
import posterDesktopSrc from '../../assets/human/poster-desktop.png';
import posterMobileSrc from '../../assets/human/poster-mobile.png';
import AutomationSteps from '../../components/AutomationSteps.astro';
import Portrait from '../../components/Portrait.astro';
import Scene from '../../components/Scene.astro';
import Timeline from '../../components/Timeline.astro';
import Todo from '../../components/Todo.astro';
import Base from '../../layouts/Base.astro';
import { BEACON_SRC, beaconConfig } from '../../lib/analytics';
import { getEntries, getSingleton } from '../../lib/data';
import { domoticaModel } from '../../lib/domotica';
import { formatDate } from '../../lib/format';
import { homelabModel } from '../../lib/homelab';
import { localeStaticPaths, localizedPath } from '../../lib/i18n';
import { loadJsonLd } from '../../lib/machine/page-jsonld';
import { isTodo, type Locale } from '../../lib/schemas/common';
import { chronological, detailPath, splitResult, workTree } from '../../lib/work';
import { createDomoticaSim, SIM_SEED, sparkPoints } from '../../scripts/three/domotica/sim';

export const getStaticPaths = localeStaticPaths;

const { locale } = Astro.props as { locale: Locale };
const [
  page,
  profile,
  theme,
  skills,
  experiences,
  certifications,
  projects,
  topics,
  infra,
  automations,
] = await Promise.all([
  getSingleton('human', locale),
  getSingleton('profile', locale),
  getSingleton('theme', locale),
  getEntries('skills', locale),
  getEntries('experiences', locale),
  getEntries('certifications', locale),
  getEntries('projects', locale),
  getEntries('topics', locale),
  getSingleton('infrastructure', locale),
  getEntries('automations', locale),
]);

/** Poster statici delle scene immersive: fallback se il 3D non parte (niente WebGL, risparmio dati, JS spento). */
const poster = (src: ImageMetadata) => getImage({ src, format: 'webp', quality: 70 });
const [
  posterDesktop,
  posterMobile,
  lavoriPosterDesktop,
  lavoriPosterMobile,
  domoticaPosterDesktop,
  domoticaPosterMobile,
] = await Promise.all([
  poster(posterDesktopSrc),
  poster(posterMobileSrc),
  poster(lavoriPosterDesktopSrc),
  poster(lavoriPosterMobileSrc),
  poster(domoticaPosterDesktopSrc),
  poster(domoticaPosterMobileSrc),
]);
const posterReasons = ['webgl', 'savedata', 'error', 'nojs'] as const;
/** Avviso del poster con il soggetto della sezione ("della scrivania", "della casa"). */
const posterNotice = (subject: string) =>
  posterReasons.map((reason) => ({
    reason,
    text: page.posterNotice[reason].replace('{subject}', subject),
  }));

const L = page.labels;
const here = (path: string) => localizedPath(path, locale);

/** Home + le otto sezioni del tema, nell'ordine di pagina (e del menu). */
const sections = [{ id: 'home' as const, title: page.homeTitle }, ...theme.sections];

/** Badge: 6–8 badge scelti nei dati (badge: true), senza livello, ciascuno verso la sezione collegata. */
const badges = skills.filter((k) => k.data.kind === 'technical' && k.data.badge === true);

/**
 * Albero dei Lavori (PORT-81): dal basso la piu vecchia, una foglia per esperienza, lati alternati.
 * Le schede partono dall'alto (la piu recente) e scendono lungo il tronco (deciso da Alessandro).
 */
const work = chronological(experiences.map((e) => ({ ...e, start: e.data.start })));
const tree = workTree(work.map((e) => ({ slug: e.slug, ...e.data })));
const newestFirst = [...work].reverse();
const leafOf = (slug: string) => tree.leaves.find((l) => l.slug === slug);
const W = page.work;
/** Punti del CV nella scheda: fino a tre; con una pagina di approfondimento due, il resto sta li. */
const highlights = (detail: boolean) => (detail ? 2 : 3);
const isTechnical = (c: (typeof certifications)[number]) => c.data.kind !== 'supplementary';
const technicalCerts = certifications.filter(isTechnical);
const supplementaryCerts = certifications.filter((c) => !isTechnical(c));
const projectsIn = (section: string) =>
  projects
    .filter((p) => p.data.section === section)
    .sort((a, b) => (a.data.rank ?? 99) - (b.data.rank ?? 99) || a.slug.localeCompare(b.slug));
/** Micro-scena di ogni attivita sportiva (slug del topic -> scena del registro). */
const sportScenes: Record<string, 'sci' | 'tennis' | 'pallavolo'> = {
  ski: 'sci',
  tennis: 'tennis',
  volleyball: 'pallavolo',
};
const topicsIn = (section: string) => topics.filter((t) => t.data.section === section);

/** Barra del tempo: una tappa per sezione, Sport con un sotto-segmento per ogni attivita. */
const timelineItems = sections.map((s) => ({
  id: s.id,
  title: s.title,
  ...(s.id === 'sport' && {
    subs: topicsIn('sport').map((t) => ({ id: `sport-${t.slug}`, title: t.data.title })),
  }),
}));

const period = (start: unknown, end: unknown) => {
  if (isTodo(start) || isTodo(end)) return null;
  return `${formatDate(start as string, locale)} – ${end === null ? L.ongoing : formatDate(end as string, locale)}`;
};
/** Sezioni col layout immersivo (spec §7.3, PORT-76): per ora solo il pilota Homelab. */
const immersive = (id: string) =>
  id === 'homelab' || id === 'home' || id === 'domotica' || id === 'lavori';
const H = page.homelab;
const homelab = homelabModel(infra);
const regionName = (id: string) => infra.regions.find((r) => r.id === id)?.name ?? id;
const nodeName = (id: string) => infra.nodes.find((n) => n.id === id)?.name ?? id;
const adrById = (id: string) => homelab.adrs.find((a) => a.id === id);

const D = page.domotica;
const domotica = domoticaModel(D.rooms, automations);
const automationBySlug = (slug: string) => automations.find((e) => e.slug === slug)?.data;
const roomName = (id: string) => D.rooms.find((r) => r.id === id)?.name ?? id;
const domoticaRooms = domotica.rooms.filter((r) => r.kind === 'room');
/** Primo quadro dei sensori simulati: lo stesso seme della scena, che poi lo fa avanzare. */
const sensors = createDomoticaSim(
  domoticaRooms.map((r) => r.id),
  SIM_SEED,
).snapshot();
const num = (value: number, digits = 0) =>
  new Intl.NumberFormat(locale, {
    minimumFractionDigits: digits,
    maximumFractionDigits: digits,
  }).format(value);

/** Canali mostrati in Contatti (email, GitHub, LinkedIn, X, piu dev.to e CV se presenti). */
const contactChannels = 4 + [profile.links.devto, profile.cv].filter((v) => !isTodo(v)).length;

const pageTitle = `${profile.name} · ${page.titleSuffix}`;
const beacon = beaconConfig(import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN);
const jsonLd = await loadJsonLd({ locale, path: '/human', name: pageTitle, type: 'ProfilePage' });
---

<Base
  locale={locale}
  path="/human"
  title={pageTitle}
  description={page.metaDescription}
  jsonLd={jsonLd}
  stickyHeader
  theme="mocha"
>
  {
    beacon && (
      <Fragment slot="head">
        <script is:inline defer src={BEACON_SRC} data-cf-beacon={beacon} />
      </Fragment>
    )
  }
  <Fragment slot="header">
    <a class="back" href={here('/')}>{page.backToChoice}</a>
    <Timeline label={page.menuLabel} toggleLabel={page.menuToggle} items={timelineItems} />
  </Fragment>

  <article class="path">
    {
      sections.map((s) => (
        <section id={s.id} data-section={s.id} aria-labelledby={`h-${s.id}`} data-story={immersive(s.id) ? '' : undefined}>
          {s.id === 'home' && (
            <div class="stage">
              <picture class="poster" aria-hidden="true">
                <source media="(max-width: 48rem)" srcset={posterMobile.src} />
                <img
                  src={posterDesktop.src}
                  width={posterDesktop.options.width}
                  height={posterDesktop.options.height}
                  alt=""
                  loading="lazy"
                  decoding="async"
                />
              </picture>
              <Scene scene="scrivania" label={page.scenes.scrivania} autostart />
            </div>
          )}
          {s.id === 'lavori' && (
            <div class="stage">
              <picture class="poster" aria-hidden="true">
                <source media="(max-width: 48rem)" srcset={lavoriPosterMobile.src} />
                <img
                  src={lavoriPosterDesktop.src}
                  width={lavoriPosterDesktop.options.width}
                  height={lavoriPosterDesktop.options.height}
                  alt=""
                  loading="lazy"
                  decoding="async"
                />
              </picture>
              <Scene scene="lavori" label={page.scenes.lavori} accent="lavori" data={tree} />
            </div>
          )}
          {s.id === 'homelab' && (
            <div class="stage">
              <Scene scene="homelab" label={page.scenes.homelab} accent="homelab" data={homelab} />
            </div>
          )}
          {s.id === 'domotica' && (
            <div class="stage">
              <picture class="poster" aria-hidden="true">
                <source media="(max-width: 48rem)" srcset={domoticaPosterMobile.src} />
                <img
                  src={domoticaPosterDesktop.src}
                  width={domoticaPosterDesktop.options.width}
                  height={domoticaPosterDesktop.options.height}
                  alt=""
                  loading="lazy"
                  decoding="async"
                />
              </picture>
              <Scene scene="domotica" label={page.scenes.domotica} accent="domotica" data={domotica} />
            </div>
          )}
          {s.id === 'home' ? (
            <h1 id="h-home">{profile.name}</h1>
          ) : (
            <h2 id={`h-${s.id}`}>{s.title}</h2>
          )}
          {!immersive(s.id) && <p class="intro">{page.intros[s.id]}</p>}

          {s.id === 'home' && (
            <>
              <div class="hero home" data-moment="hero">
                <div class="glass">
                  <div class="who">
                    <Portrait photo={profile.photo} todoLabel={page.todoLabel} />
                    <p class="greeting">{page.home.greeting}</p>
                  </div>
                  <nav aria-label={page.home.badgesLabel}>
                    <ul class="badges">
                      {badges.map((k) => (
                        <li>
                          <a href={`#${k.data.linkedSection}`} data-to={k.data.linkedSection}>
                            {k.data.name}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </nav>
                  <p class="hint">{page.home.scrollHint}</p>
                  <p class="poster-note" role="status">
                    {posterNotice(page.home.posterSubject).map((n) => <span data-reason={n.reason}>{n.text}</span>)}
                  </p>
                </div>
              </div>
              <div class="exit" data-moment="exit" aria-hidden="true"></div>
            </>
          )}

          {s.id === 'interessi' && (
            <Scene
              scene="interessi"
              label={page.scenes.interessi}
              accent="interessi"
              data={{ items: topicsIn('interessi').map((t) => t.slug) }}
            />
          )}

          {s.id === 'lavori' && (
            <>
              <div class="hero lab" data-moment="overview">
                <p class="intro">{page.intros[s.id]}</p>
                <p class="poster-note" role="status">
                  {posterNotice(W.posterSubject).map((n) => <span data-reason={n.reason}>{n.text}</span>)}
                </p>
              </div>

              <div class="cards">
                {newestFirst.map(({ slug, data: e }) => {
                  const when = period(e.start, e.end);
                  const leaf = leafOf(slug);
                  const volunteer = e.kind === 'volunteer';
                  const company = isTodo(e.company) ? null : e.company;
                  return (
                    <article class="card job" data-moment={slug} data-side={leaf?.side} data-kind={e.kind}>
                      <h3>{isTodo(e.role) ? <Todo label={page.todoLabel} hint={e.role.todo} /> : e.role}</h3>
                      <p class="org">
                        <strong>{company ?? <Todo label={page.todoLabel} hint={isTodo(e.company) ? e.company.todo : ''} />}</strong>
                        {volunteer && <span class="chip">{W.volunteer}</span>}
                      </p>
                      <p class="meta">
                        {when ?? (
                          <Todo
                            label={page.todoLabel}
                            hint={isTodo(e.start) ? e.start.todo : isTodo(e.end) ? e.end.todo : ''}
                          />
                        )}
                      </p>
                      {/* Il volontariato e gia marcato: un riassunto che dice solo "Volontariato" non si ripete. */}
                      {e.summary && e.summary.toLocaleLowerCase(locale) !== W.volunteer.toLocaleLowerCase(locale) && (
                        <p class="summary">{e.summary}</p>
                      )}
                      <h4>{W.highlights}</h4>
                      {isTodo(e.results) ? (
                        <p><Todo label={page.todoLabel} hint={e.results.todo} /></p>
                      ) : (
                        <ul>
                          {e.results.slice(0, highlights(e.detail !== undefined)).map(splitResult).map((r) => (
                            <li>{r.label && <strong>{r.label}: </strong>}{r.text}</li>
                          ))}
                        </ul>
                      )}
                      {!isTodo(e.stack) && e.stack.length > 0 && (
                        <>
                          <h4>{L.stack}</h4>
                          <ul class="tags">{e.stack.map((t) => <li>{t}</li>)}</ul>
                        </>
                      )}
                      {isTodo(e.stack) && (
                        <>
                          <h4>{L.stack}</h4>
                          <p><Todo label={page.todoLabel} hint={e.stack.todo} /></p>
                        </>
                      )}
                      {e.detail && (
                        <p class="deeper">
                          <a
                            class="button"
                            href={here(detailPath(e.detail))}
                            aria-label={W.deeperLabel.replace('{company}', company ?? '')}
                          >
                            {W.deeper} <span aria-hidden="true">→</span>
                          </a>
                        </p>
                      )}
                    </article>
                  );
                })}
              </div>
              <div class="exit" data-moment="exit" aria-hidden="true"></div>
            </>
          )}

          {s.id === 'homelab' && (
            <>
              <div class="hero lab" data-moment="overview">
                <p class="intro">{page.intros[s.id]}</p>
                <div class="lab-ui" data-panel-ui hidden>
                  <p class="meta">{H.sceneHint}</p>
                  <div class="lab-controls">
                    <ul class="plain lab-nodes" aria-label={H.nodesLabel}>
                      {homelab.regions.flatMap((r) =>
                        r.nodes.map((n) => (
                          <li>
                            <button type="button" data-panel-open={n.id} aria-expanded="false" aria-controls="homelab-panel">
                              {n.name} <span class="meta">· {r.name}</span>
                            </button>
                          </li>
                        )),
                      )}
                    </ul>
                    <div class="lab-layers" role="group" aria-label={H.layersLabel}>
                      <button type="button" data-layer="decisions" aria-pressed="false">{H.decisions}</button>
                      <button type="button" data-layer="backup" aria-pressed="false">{H.backup}</button>
                      <button type="button" data-layer="wip" aria-pressed="true">{H.wip}</button>
                    </div>
                  </div>
                  {homelab.failover && (
                    <div class="lab-failover">
                      <button type="button" data-failover data-start={H.failoverStart} data-stop={H.failoverStop}>
                        {H.failoverStart}
                      </button>
                      <p class="meta" role="status" data-failover-status data-normal={H.failoverNormal} data-active={H.failoverActive}></p>
                    </div>
                  )}
                  <div class="lab-panel" id="homelab-panel" data-panel hidden>
                    {homelab.regions.flatMap((r) =>
                      r.nodes.map((n) => (
                        <div data-panel-item={n.id} hidden>
                          <h3 tabindex="-1" data-panel-heading>{n.name} <span class="meta">· {r.name}</span></h3>
                          <h4>{H.services}</h4>
                          <ul class="plain">{n.services.map((svc) => <li>{svc.name}</li>)}</ul>
                          <div class="lab-metrics">
                            <h4>{H.metrics}</h4>
                            <dl class="lab-gauges">
                              {(['cpu', 'ram', 'net'] as const).map((k) => (
                                <div>
                                  <dt>{H[k]}</dt>
                                  <dd>
                                    <span data-metric={k}>–</span>
                                    <svg data-spark={k} viewBox="0 0 60 16" preserveAspectRatio="none" aria-hidden="true" focusable="false"><polyline points="" /></svg>
                                  </dd>
                                </div>
                              ))}
                            </dl>
                            <h4>{H.logs}</h4>
                            <ol class="plain lab-log" data-log></ol>
                          </div>
                          <div data-panel-adrs hidden>
                            <h4>{H.decisions}</h4>
                            {n.adrs.length === 0 ? (
                              <p class="meta">{H.noAdrs}</p>
                            ) : (
                              <ul class="plain">
                                {n.adrs.map((id) => adrById(id)).map((a) => a && (
                                  <li>
                                    <a href={a.url}>{a.title}</a>
                                    <p>{a.summary}</p>
                                  </li>
                                ))}
                              </ul>
                            )}
                          </div>
                        </div>
                      )),
                    )}
                    <button type="button" class="lab-close" data-panel-close>{H.close}</button>
                  </div>
                </div>
              </div>

              <div class="cards">
              <article class="card" data-moment="nodes">
              <h3>{H.nodesLabel}</h3>
              <p class="meta">{page.homelab.simulatedNote}</p>
              <table>
                <caption>{H.caption}</caption>
                <thead>
                  <tr>
                    <th scope="col">{H.region}</th>
                    <th scope="col">{H.node}</th>
                    <th scope="col">{H.services}</th>
                  </tr>
                </thead>
                <tbody>
                  {homelab.regions.flatMap((r) =>
                    r.nodes.map((n) => (
                      <tr data-node={n.id}>
                        <td>{r.name}</td>
                        <th scope="row">{n.name}</th>
                        <td>
                          <ul class="plain">{n.services.map((svc) => <li data-service={svc.id}>{svc.name}</li>)}</ul>
                        </td>
                      </tr>
                    )),
                  )}
                </tbody>
              </table>
              </article>

              <article class="card" data-moment="decisions">
              <h3>{H.decisions}</h3>
              <ul class="plain">
                {homelab.adrs.map((a) => (
                  <li data-adr={a.id}>
                    <strong><a href={a.url}>{a.title}</a></strong>
                    <p>{a.summary}</p>
                    <p class="meta">{H.node}: {a.nodes.map(nodeName).join(', ')}</p>
                  </li>
                ))}
              </ul>
              </article>

              {homelab.failover && (
                <article class="card" data-moment="failover">
                  <h3>{H.failoverTitle}</h3>
                  <p>{H.failoverText}</p>
                </article>
              )}

              <article class="card" data-moment="backup">
              <h3>{H.backup}</h3>
              <p>{H.backupIntro} <strong>{homelab.backup.source.name}</strong></p>
              <ul class="plain">
                {homelab.backup.targets.map((t) => (
                  <li data-target={t.id}>
                    {t.name}
                    <span class="meta"> · {t.medium === 'cloud' ? H.cloud : H.local}, {t.offsite ? H.offsite : H.onsite}</span>
                  </li>
                ))}
              </ul>
              </article>

              <article class="card" data-moment="wip">
              <h3>{H.wip}</h3>
              <ul class="plain">
                {homelab.wip.map((w) => (
                  <li data-wip={w.id}>
                    <strong>{w.name}</strong> <span class="meta">({H.underConstruction} · {regionName(w.region)})</span>
                    <p>{w.summary}</p>
                  </li>
                ))}
              </ul>
              </article>

              <article class="card" data-moment="projects">
                <h3>{H.projects}</h3>
                {projectsIn(s.id).map(({ data: p }) => (
                  <div class="item">
                    <h4>{p.name}</h4>
                    <p>{isTodo(p.description) ? <Todo label={page.todoLabel} hint={p.description.todo} /> : p.description}</p>
                    <p class="meta"><a href={p.repo}>{L.repository}</a></p>
                  </div>
                ))}
              </article>
              </div>
            </>
          )}

          {s.id === 'domotica' && (
            <>
              <div class="hero lab" data-moment="overview">
                <p class="intro">{page.intros[s.id]}</p>
                <p class="poster-note" role="status">
                  {posterNotice(D.posterSubject).map((n) => <span data-reason={n.reason}>{n.text}</span>)}
                </p>
                <div class="lab-ui" data-panel-ui hidden>
                  <p class="meta">{D.sceneHint}</p>
                  <div class="lab-controls">
                    <ul class="plain lab-nodes" aria-label={D.roomsLabel}>
                      {domotica.rooms.map((r) => (
                        <li>
                          <button type="button" data-panel-open={r.id} aria-expanded="false" aria-controls="domotica-panel">
                            {r.name}
                          </button>
                        </li>
                      ))}
                    </ul>
                  </div>
                  <div class="lab-panel" id="domotica-panel" data-panel hidden>
                    {domotica.rooms.map((r) => (
                      <div data-panel-item={r.id} hidden>
                        <h3 tabindex="-1" data-panel-heading>{r.name}</h3>
                        {r.automations.length === 0 ? (
                          <p class="meta">{D.noAutomations}</p>
                        ) : (
                          r.automations.map((slug) => automationBySlug(slug)).map((a) => a && (
                            <article>
                              <h4>{a.name}</h4>
                              <AutomationSteps automation={a} labels={D} todoLabel={page.todoLabel} />
                            </article>
                          ))
                        )}
                      </div>
                    ))}
                    <button type="button" class="lab-close" data-panel-close>{D.close}</button>
                  </div>
                </div>
              </div>

              <div class="cards">
                <article class="card" data-moment="climate">
                  <h3>{D.climate.title}</h3>
                  <p>{D.climate.text}</p>
                  <p class="meta">{D.simulatedNote}</p>
                  <table>
                    <thead>
                      <tr>
                        <th scope="col">{D.room}</th>
                        <th scope="col">{D.climate.temperature}</th>
                        <th scope="col">{D.climate.humidity}</th>
                      </tr>
                    </thead>
                    <tbody>
                      {domoticaRooms.map((r) => (
                        <tr>
                          <th scope="row">{r.name}</th>
                          <td><span data-sim={`rooms.${r.id}.temperature`} data-digits="1">{num(sensors.rooms[r.id]?.temperature ?? 0, 1)}</span> °C</td>
                          <td><span data-sim={`rooms.${r.id}.humidity`}>{num(sensors.rooms[r.id]?.humidity ?? 0)}</span> %</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </article>

                {domotica.automations.map(({ slug }) => {
                  const a = automationBySlug(slug);
                  return a && (
                    <article class="card" data-moment={slug} data-automation={slug}>
                      <h3>{a.name} <span class="meta">· {roomName(a.room)}</span></h3>
                      <AutomationSteps automation={a} labels={D} todoLabel={page.todoLabel} />
                      {a.repo && <p class="meta"><a href={a.repo}>{L.repository}</a></p>}
                    </article>
                  );
                })}

                <article class="card" data-moment="audio">
                  <h3>{D.audio.title}</h3>
                  <p>{D.audio.text}</p>
                  <p>{D.audio.rooms}</p>
                  <ul class="tags">{domoticaRooms.map((r) => <li>{r.name}</li>)}</ul>
                </article>

                <article class="card" data-moment="weather">
                  <h3>{D.weather.title}</h3>
                  <p>{D.weather.text}</p>
                  <p class="meta">{D.simulatedNote}</p>
                  <h4>{D.weather.air}</h4>
                  <dl class="lab-gauges">
                    <div><dt>{D.weather.co2}</dt><dd><span data-sim="air.co2">{num(sensors.air.co2)}</span> ppm</dd></div>
                    <div><dt>{D.weather.voc}</dt><dd><span data-sim="air.voc">{num(sensors.air.voc)}</span></dd></div>
                    <div><dt>{D.weather.pm25}</dt><dd><span data-sim="air.pm25" data-digits="1">{num(sensors.air.pm25, 1)}</span> µg/m³</dd></div>
                  </dl>
                  <h4>{D.weather.station}</h4>
                  <dl class="lab-gauges">
                    <div>
                      <dt>{D.weather.pressure}</dt>
                      <dd>
                        <span data-sim="weather.pressure" data-digits="1">{num(sensors.weather.pressure, 1)}</span> hPa
                        <svg data-sim-spark viewBox="0 0 60 16" preserveAspectRatio="none" aria-hidden="true" focusable="false"><polyline points={sparkPoints(sensors.pressureHistory)} /></svg>
                      </dd>
                    </div>
                    <div><dt>{D.weather.outdoorTemperature}</dt><dd><span data-sim="weather.temperature" data-digits="1">{num(sensors.weather.temperature, 1)}</span> °C</dd></div>
                    <div><dt>{D.weather.outdoorHumidity}</dt><dd><span data-sim="weather.humidity">{num(sensors.weather.humidity)}</span> %</dd></div>
                    <div><dt>{D.weather.wind}</dt><dd><span data-sim="weather.wind">{num(sensors.weather.wind)}</span> km/h</dd></div>
                  </dl>
                  <h4>{D.weather.trendLabel}</h4>
                  <p>
                    {(['falling', 'steady', 'rising'] as const).map((t) => (
                      <span data-trend={t} hidden={t !== sensors.trend}>{D.weather[t]}</span>
                    ))}
                  </p>
                </article>

                <article class="card" data-moment="projects">
                  <h3>{D.projects}</h3>
                  {projectsIn(s.id).map(({ data: p }) => (
                    <div class="item">
                      <h4>{p.name}</h4>
                      <p>{isTodo(p.description) ? <Todo label={page.todoLabel} hint={p.description.todo} /> : p.description}</p>
                      <p class="meta"><a href={p.repo}>{L.repository}</a></p>
                    </div>
                  ))}
                  <p><Todo label={page.todoLabel} hint={D.automationsTodo} /></p>
                </article>
              </div>
            </>
          )}

          {s.id === 'certificazioni' && (
            <>
              <Scene
                scene="certificazioni"
                label={page.scenes.certificazioni}
                accent="certificazioni"
                data={{ technical: technicalCerts.length, supplementary: supplementaryCerts.length }}
              />
              <h3>{L.technicalCertifications}</h3>
              <ul class="plain">
                {technicalCerts.map(({ data: c }) => (
                  <li>
                    <strong>{isTodo(c.name) ? <Todo label={page.todoLabel} hint={c.name.todo} /> : c.name}</strong>
                    <span class="meta">
                      {L.issuer}: {isTodo(c.issuer) ? <Todo label={page.todoLabel} hint={c.issuer.todo} /> : c.issuer}
                      {' · '}
                      {isTodo(c.date) ? <Todo label={page.todoLabel} hint={c.date.todo} /> : formatDate(c.date, locale)}
                    </span>
                    {!isTodo(c.verifyUrl) && <a href={c.verifyUrl}>{L.verify}</a>}
                  </li>
                ))}
              </ul>
              {supplementaryCerts.length > 0 && (
                <>
                  <h3 class="small">{L.supplementaryCertifications}</h3>
                  <ul class="plain small">
                    {supplementaryCerts.map(({ data: c }) => (
                      <li>{isTodo(c.name) ? <Todo label={page.todoLabel} hint={c.name.todo} /> : c.name}</li>
                    ))}
                  </ul>
                </>
              )}
            </>
          )}

          {s.id === 'beneficenza' && (
            <Scene
              scene="beneficenza"
              label={page.scenes.beneficenza}
              accent="beneficenza"
              data={{ count: topicsIn('beneficenza').length }}
            />
          )}

          {(s.id === 'sport' || s.id === 'interessi' || s.id === 'beneficenza') &&
            topicsIn(s.id).map(({ slug, data: t }) => (
              <article class="item" id={`${s.id}-${slug}`}>
                {s.id === 'sport' && sportScenes[slug] && (
                  <Scene
                    scene={sportScenes[slug]}
                    label={page.scenes[sportScenes[slug]]}
                    accent="sport"
                  />
                )}
                <h3>{t.title}</h3>
                {t.tagline && <p class="tagline"><em>{t.tagline}</em></p>}
                <p>{isTodo(t.text) ? <Todo label={page.todoLabel} hint={t.text.todo} /> : t.text}</p>
                {t.links.length > 0 && (
                  <ul class="plain inline">
                    {t.links.map((l) => <li><a href={l.url}>{l.label}</a></li>)}
                  </ul>
                )}
              </article>
            ))}

          {s.id === 'contatti' && (
            <>
            <Scene scene="contatti" label={page.scenes.contatti} accent="contatti" data={{ count: contactChannels }} />
            <dl class="facts">
              <div>
                <dt>{L.email}</dt>
                <dd><a href={`mailto:${profile.email}`}>{profile.email}</a></dd>
              </div>
              <div>
                <dt>{L.profiles}</dt>
                <dd>
                  <ul class="plain inline">
                    <li><a href={profile.links.github}>GitHub</a></li>
                    <li><a href={profile.links.linkedin}>LinkedIn</a></li>
                    {!isTodo(profile.links.devto) && <li><a href={profile.links.devto}>dev.to</a></li>}
                    <li><a href={profile.links.x}>X</a></li>
                  </ul>
                </dd>
              </div>
              <div>
                <dt>{L.cv}</dt>
                <dd>
                  {isTodo(profile.cv) ? (
                    <Todo label={page.todoLabel} hint={profile.cv.todo} />
                  ) : (
                    <a class="button" href={profile.cv} download>{L.cv}</a>
                  )}
                </dd>
              </div>
            </dl>
            <p class="farewell">
              <code>{page.farewell.command}</code>
              <br />
              {page.farewell.message}
              <a href={here('/')}>{page.backToChoice}</a>
            </p>
            </>
          )}
        </section>
      ))
    }
  </article>
</Base>

<style>
