  section[data-section="lavori"] > .cards {
    max-width: 72rem;
  }
  @media (min-width: 60rem) and (scripting: enabled) {
    section[data-section="lavori"]:not(:has(.scene[data-scene-state="text"])) .job[data-side="right"] {
