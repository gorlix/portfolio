  section[data-section="interessi"] { --accent: var(--sec-interessi); --accent-ink: var(--sec-interessi-ink); }
  section[data-section="beneficenza"] { --accent: var(--sec-beneficenza); --accent-ink: var(--sec-beneficenza-ink); }
  section[data-section="contatti"] { --accent: var(--sec-contatti); --accent-ink: var(--sec-contatti-ink); }
  section[id] > :not(h1):not(h2) {
