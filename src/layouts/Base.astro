---
import '../styles/global.css';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import { getSingleton } from '../lib/data';
import { absoluteUrl, alternates, localizedPath } from '../lib/i18n';
import { serializeJsonLd } from '../lib/machine/jsonld';
import { type Locale, locales } from '../lib/schemas/common';

interface Props {
  locale: Locale;
  /** Percorso della pagina senza prefisso lingua (es. `/` o `/recruiter`). */
  path: string;
  title: string;
  description: string;
  /** Intestazione sempre visibile (menu a ancore del recruiter). */
  stickyHeader?: boolean;
  /** Dati strutturati schema.org incorporati come `application/ld+json` (non eseguibile). */
  jsonLd?: Record<string, unknown>;
  /** Forza la variante Mocha (percorso /human) ignorando prefers-color-scheme. */
  theme?: 'mocha';
  /** Pagina 404: non e un indirizzo vero, quindi niente canonical, hreflang e selettore lingua. */
  notFound?: boolean;
}

const {
  locale,
  path,
  title,
  description,
  stickyHeader = false,
  jsonLd,
  theme,
  notFound = false,
} = Astro.props;
const ogLocale: Record<Locale, string> = { it: 'it_IT', en: 'en_US' };
const pageUrl = absoluteUrl(localizedPath(path, locale));
const otherLocales = locales.filter((l) => l !== locale);
const ui = await getSingleton('ui', locale);
---

<!doctype html>
<html lang={locale} data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {
      notFound ? (
        <meta name="robots" content="noindex" />
      ) : (
        <>
          <link rel="canonical" href={pageUrl} />
          <meta property="og:type" content="website" />
          <meta property="og:site_name" content={title} />
          <meta property="og:title" content={title} />
          <meta property="og:description" content={description} />
          <meta property="og:url" content={pageUrl} />
          <meta property="og:locale" content={ogLocale[locale]} />
          {otherLocales.map((l) => <meta property="og:locale:alternate" content={ogLocale[l]} />)}
          <meta name="twitter:card" content="summary" />
          {alternates(path).map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
        </>
      )
    }
    {jsonLd && <script type="application/ld+json" set:html={serializeJsonLd(jsonLd)} />}
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">{ui.skipToContent}</a>
    <header class:list={['site-header', { fixed: stickyHeader }]}>
      <slot name="header" />
      {!notFound && <LanguageSwitcher locale={locale} path={path} />}
    </header>
    <main id="main"><slot /></main>
    <slot name="footer" />
  </body>
</html>

<style is:global>
  .site-header.fixed {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding: 0.5rem 1rem;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
  }
  @media (min-width: 48rem) {
    .site-header.fixed {
      position: sticky;
      top: 0;
      z-index: 1;
    }
  }
  .skip {
    position: absolute;
    left: -999px;
  }
  .skip:focus {
    left: 0.5rem;
    top: 0.5rem;
    padding: 0.5rem 1rem;
    background: var(--surface);
    color: var(--text);
  }
</style>
