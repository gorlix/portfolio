---
import '../styles/global.css';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import { getSingleton } from '../lib/data';
import { absoluteUrl, alternates, localizedPath } from '../lib/i18n';
import { type Locale, locales } from '../lib/schemas/common';

interface Props {
  locale: Locale;
  /** Percorso della pagina senza prefisso lingua (es. `/` o `/recruiter`). */
  path: string;
  title: string;
  description: string;
}

const { locale, path, title, description } = Astro.props;
const ogLocale: Record<Locale, string> = { it: 'it_IT', en: 'en_US' };
const pageUrl = absoluteUrl(localizedPath(path, locale));
const otherLocales = locales.filter((l) => l !== locale);
const ui = await getSingleton('ui', locale);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={title} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:locale" content={ogLocale[locale]} />
    {otherLocales.map((l) => <meta property="og:locale:alternate" content={ogLocale[l]} />)}
    <meta name="twitter:card" content="summary" />
    {alternates(path).map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
  </head>
  <body>
    <a class="skip" href="#main">{ui.skipToContent}</a>
    <header><LanguageSwitcher locale={locale} path={path} /></header>
    <main id="main"><slot /></main>
  </body>
</html>

<style is:global>
  .skip {
    position: absolute;
    left: -999px;
  }
  .skip:focus {
    left: 0.5rem;
    top: 0.5rem;
    padding: 0.5rem 1rem;
    background: var(--surface);
    color: var(--text);
  }
</style>
