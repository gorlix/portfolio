---
import type { sectionIds } from '../lib/schemas/common';
import { sceneKind } from '../scripts/three/kinds';
import type { SceneName } from '../scripts/three/registry';

type SectionId = (typeof sectionIds)[number];

/*
 * Isola 3D di /human (PORT-46). Riquadro con dimensioni riservate (nessun layout shift) che il
 * bootstrap riempie con un canvas solo quando la sezione si avvicina e il dispositivo lo consente.
 * Il contenuto vero sta nel testo della sezione, fuori da qui: il 3D e solo un'illustrazione.
 * Da usare SOLO nella pagina /human: e l'unico punto che include lo script 3D.
 */
interface Props {
  /** Scena del registro (src/scripts/three/registry.ts). */
  scene: SceneName;
  /** Testo alternativo della scena (dai YAML IT/EN, mai scritto qui). */
  label: string;
  /** Sezione di appartenenza: i colori arrivano dai token `--sec-<accent>` del tema. */
  accent?: SectionId;
  /**
   * Dati della scena, gli stessi che la pagina usa per l'equivalente testuale. Viaggiano come
   * blocco JSON (non eseguibile, compatibile con la CSP) e il bootstrap li passa al modulo.
   */
  data?: unknown;
  /** Parte da sola a pagina caricata e inattiva, senza aspettare un gesto (solo per la prima schermata). */
  autostart?: boolean;
}

const { scene, label, accent, data, autostart } = Astro.props;
const kind = sceneKind(scene);
// `<` escapato: il blocco non puo chiudere lo script ne aprire tag, qualunque sia il testo.
const json = data === undefined ? undefined : JSON.stringify(data).replace(/</g, '\\u003c');
---

<div class="scene" data-scene={scene} data-kind={kind} data-accent={accent} data-autostart={autostart ? "" : undefined} role="img" aria-label={label}>
  {json && <script is:inline type="application/json" data-scene-data set:html={json} />}
</div>

<style>
  .scene {
    position: relative;
    width: 100%;
    max-width: 40rem;
    aspect-ratio: 4 / 3;
    margin-inline: auto;
    contain: layout paint;
  }
  /* Scena immersiva: riempie lo sfondo fisso della sezione (lo "stage" della pagina). */
  .scene[data-kind='immersive'] {
    max-width: none;
    height: 100%;
    aspect-ratio: auto;
  }
  .scene[hidden] {
    display: none;
  }
  .scene :global(canvas) {
    position: absolute;
    /* Solo i gesti orizzontali vanno alla scena: lo scroll verticale resta sempre della pagina. */
    touch-action: pan-y;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }
</style>

<script>
  import '../scripts/three/bootstrap.ts';
</script>
