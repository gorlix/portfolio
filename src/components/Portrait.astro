---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { isTodo, type Todo as TodoValue } from '../lib/schemas/common';

interface Props {
  photo: { src: string; alt: string } | TodoValue;
}

/** Lato del ritratto in px (deve coincidere con `.portrait` sotto): spazio sempre riservato, nessun layout shift. */
const size = 160;

const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/**/*.{jpg,jpeg,png,webp,avif}',
  { eager: true },
);

const { photo } = Astro.props;
const asset = isTodo(photo) ? undefined : images[photo.src]?.default;
if (!isTodo(photo) && !asset) throw new Error(`Foto non trovata: ${photo.src}`);
---

<div class="portrait">
  {
    asset && !isTodo(photo) ? (
      <Image
        src={asset}
        alt={photo.alt}
        width={size}
        height={size}
        densities={[1, 2]}
        format="webp"
        quality={80}
        loading="eager"
      />
    ) : null
  }
</div>

<style>
  .portrait {
    flex: none;
    box-sizing: border-box;
    width: 160px;
    height: 160px;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    background: var(--surface);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .portrait :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
