---
import { getSingleton } from '../lib/data';
import { localizedPath } from '../lib/i18n';
import { type Locale, locales } from '../lib/schemas/common';

interface Props {
  locale: Locale;
  /** Percorso della pagina corrente senza prefisso lingua (es. `/recruiter`). */
  path: string;
}

const { locale, path } = Astro.props;
const ui = await getSingleton('ui', locale);
---

<nav aria-label={ui.languageSwitcher.label}>
  <ul>
    {
      locales.map((l) => (
        <li>
          <a
            href={localizedPath(path, l)}
            hreflang={l}
            lang={l}
            aria-current={l === locale ? 'true' : undefined}
          >
            {ui.languageSwitcher[l]}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  ul {
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
    border: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }
  li + li {
    border-left: 1px solid var(--border);
  }
  a {
    display: inline-flex;
    align-items: center;
    min-height: 1.5rem;
    padding: 0 0.625rem;
    color: var(--text-muted);
    text-decoration: none;
  }
  a:hover {
    color: var(--text);
    text-decoration: underline;
  }
  a[aria-current] {
    background: var(--text);
    color: var(--bg);
    font-weight: 700;
    text-decoration: none;
  }
</style>
