---
import { getSingleton } from '../lib/data';
import { defaultLocale, localizedPath } from '../lib/i18n';
import { isTodo, type Locale } from '../lib/schemas/common';

interface Props {
  locale: Locale;
}

/*
 * Ingresso `/` come sessione tmux (PORT-90): pane principale col saluto e la scelta, pane laterale
 * con dati statici del profilo, barra di stato in basso. Il testo e i tre link sono HTML: la
 * pagina e completa senza JS; src/scripts/terminal.ts aggiunge solo digitazione e tastiera.
 */
const { locale } = Astro.props;
const [entrance, profile] = await Promise.all([
  getSingleton('entrance', locale),
  getSingleton('profile', locale),
]);
const { tmux } = entrance;
const info = [
  { label: tmux.infoRole, value: profile.role },
  { label: tmux.infoLocation, value: profile.location },
].filter((row): row is { label: string; value: string } => !isTodo(row.value));
---

<section class="tmux" aria-labelledby="terminal-title" data-terminal data-default-locale={defaultLocale}>
  <div class="panes">
    <div class="pane main">
      <div class="title" aria-hidden="true">
        <span>0</span><span>{tmux.mainPane}</span>
      </div>
      <header class="head">
        <h1 id="terminal-title">{profile.name}</h1>
        <button type="button" class="skip-typing" data-skip hidden>{entrance.skip}</button>
      </header>
      <div class="screen">
        <p class="cmd" data-line>{entrance.command}</p>
        {entrance.greeting.map((line) => <p data-line>{line}</p>)}
        <p id="who" class="question" data-line>{entrance.question}</p>
        <ol class="choices" aria-labelledby="who" data-choices>
          {
            entrance.choices.map((c) => (
              <li>
                <a href={localizedPath(c.path, locale)}>{c.label}</a>
              </li>
            ))
          }
        </ol>
        <p class="hint" data-hint hidden>{entrance.hints.keys}</p>
        <p class="hint" data-hint hidden>{entrance.hints.lang}</p>
        <p class="prompt" aria-hidden="true">$ <span class="cursor"></span></p>
      </div>
    </div>

    {
      info.length > 0 && (
        <aside class="pane side" aria-label={tmux.infoPane}>
          <div class="title" aria-hidden="true">
            <span>1</span><span>{tmux.infoPane}</span>
          </div>
          <dl>
            {info.map((row) => (
              <>
                <dt>{row.label}</dt>
                <dd>{row.value}</dd>
              </>
            ))}
          </dl>
        </aside>
      )
    }
  </div>

  <footer class="status" aria-hidden="true">
    <span class="session">[{tmux.session}]</span>
    <ul class="windows">
      <li class="win current">0:<span class="wn">{tmux.mainPane}</span>*</li>
      {entrance.choices.map((c, i) => <li class="win" data-win={i + 1}>{i + 1}:{c.label}</li>)}
    </ul>
    <span class="lang">{locale}</span>
  </footer>
</section>

<style>
  /* La pagina riempie lo schermo: i pane si allungano e la barra di stato resta in fondo. */
  :global(body:has([data-terminal])) {
    display: flex;
    flex-direction: column;
    min-height: 100svh;
  }
  :global(body:has([data-terminal]) main) {
    display: flex;
    flex: 1;
  }
  .tmux {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-width: 0;
    font-family: var(--font-mono);
    line-height: 1.6;
  }
  .panes {
    display: grid;
    flex: 1;
    gap: 1.5rem;
    align-content: start;
    padding: 1.75rem 1rem 1.25rem;
    background: var(--bg-alt);
  }
  @media (min-width: 48rem) {
    .panes {
      grid-template-columns: minmax(0, 1fr) 16rem;
      gap: 0.25rem;
      align-content: stretch;
      padding: 0.25rem;
    }
  }

  /* Pane: bordo sottile col titolo sul bordo (come pane-border-status); l'attivo ha il bordo evidenziato. */
  .pane {
    position: relative;
    box-sizing: border-box;
    min-width: 0;
    padding: 1.25rem 1rem 1rem;
    border: 1px solid var(--border);
    background: var(--bg);
  }
  .pane.main {
    border-color: var(--focus);
  }
  .title {
    position: absolute;
    top: 0;
    left: 0.75rem;
    display: flex;
    gap: 0.25rem;
    padding: 0 0.5rem;
    transform: translateY(-50%);
    background: var(--bg);
    color: var(--text-muted);
    font-size: 0.75rem;
    line-height: 1;
  }
  .title span:first-child::after {
    content: ":";
  }
  .main .title {
    color: var(--text);
  }

  .head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 1.75rem;
  }
  h1 {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-muted);
  }
  .skip-typing {
    padding: 0 0.5rem;
    min-height: 1.5rem;
    border: 1px solid var(--border);
    background: transparent;
    color: var(--text);
    font: inherit;
    font-size: 0.75rem;
    cursor: pointer;
  }
  .skip-typing:hover {
    background: var(--surface);
  }
  .screen p {
    margin: 0;
  }
  .screen .cmd {
    margin-top: 0.5rem;
    color: var(--text-muted);
  }
  .screen .question {
    margin-top: 1rem;
    font-weight: 700;
  }

  /* La scelta e un menu tmux (display-menu): voci numerate, cursore `>` sulla voce attiva. */
  .choices {
    display: inline-block;
    min-width: min(100%, 16rem);
    box-sizing: border-box;
    margin: 0.5rem 0 0;
    padding: 0.25rem 0;
    border: 1px solid var(--border);
    list-style: none;
    counter-reset: choice;
  }
  .choices li {
    counter-increment: choice;
  }
  .choices a {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 1.75rem;
    padding: 0 1rem 0 0.5rem;
    color: var(--text);
    text-decoration: none;
  }
  .choices a::before {
    content: "  (" counter(choice) ")";
    color: var(--text-muted);
    white-space: pre;
  }
  .choices a:hover,
  .choices a:focus-visible {
    background: var(--text);
    color: var(--bg);
    outline-offset: -2px;
  }
  .choices a:hover::before,
  .choices a:focus-visible::before {
    content: "> (" counter(choice) ")";
    color: inherit;
  }
  .screen .hint {
    margin-top: 0.75rem;
    color: var(--text-muted);
    font-size: 0.875rem;
  }
  .screen .prompt {
    margin-top: 1rem;
    color: var(--text-muted);
  }
  .cursor {
    display: inline-block;
    width: 0.6em;
    height: 1.1em;
    vertical-align: text-bottom;
    background: var(--text);
  }
  @media (prefers-reduced-motion: no-preference) {
    .cursor {
      animation: blink 1.1s steps(1) infinite;
    }
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  .screen :global(.rest),
  .screen :global(.pending) {
    visibility: hidden;
  }
  .screen :global(.sr-only) {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .side {
    align-self: start;
  }
  dl {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.25rem 1rem;
    margin: 0.25rem 0 0;
    font-size: 0.875rem;
  }
  dt {
    color: var(--text-muted);
  }
  dd {
    margin: 0;
    overflow-wrap: anywhere;
  }

  /* Barra di stato: sessione, finestre (la voce con il focus si illumina, senza JS), lingua. */
  .status {
    display: flex;
    align-items: center;
    gap: 1rem;
    box-sizing: border-box;
    min-height: 1.75rem;
    padding: 0 0.75rem;
    overflow: hidden;
    background: var(--surface);
    border-top: 1px solid var(--border);
    font-size: 0.8125rem;
    white-space: nowrap;
  }
  .session {
    color: var(--sec-homelab-ink);
    font-weight: 700;
  }
  .windows {
    display: flex;
    flex: 1;
    gap: 1rem;
    min-width: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .win {
    padding: 0 0.375rem;
    color: var(--text-muted);
  }
  .win.current,
  .tmux:has(.choices li:nth-child(1) a:is(:hover, :focus-visible)) .win[data-win="1"],
  .tmux:has(.choices li:nth-child(2) a:is(:hover, :focus-visible)) .win[data-win="2"],
  .tmux:has(.choices li:nth-child(3) a:is(:hover, :focus-visible)) .win[data-win="3"] {
    background: var(--text);
    color: var(--bg);
  }
  .tmux:has(.choices a:is(:hover, :focus-visible)) .win.current {
    background: none;
    color: var(--text-muted);
  }
  .lang {
    color: var(--text-muted);
  }
  @media (max-width: 30rem) {
    .session,
    .lang {
      display: none;
    }
    .windows {
      gap: 0.25rem;
    }
    .wn {
      display: none;
    }
  }
</style>

<script>
  import '../scripts/terminal.ts';
</script>
